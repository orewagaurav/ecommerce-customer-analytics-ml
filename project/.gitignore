# Ignore all CSV files by default
*.csv

# Ignore data folder contents by default
data/*

# The processed CSV is derivable (scripts/get_data.py) and was ~80 MB in every
# clone. Inference reads feature_store/*.parquet instead, which is ~1 MB.
# Python bytecode
__pycache__/
*.pyc

# Virtual environment
.venv/

# macOS
.DS_Store

# Coverage
.coverage
htmlcov/
.pytest_cache/
